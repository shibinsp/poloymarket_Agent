# Polymarket - private key derives API credentials via L1 auth
POLYMARKET_PRIVATE_KEY=0x...

# Valuation model API key. LLM_API_KEY takes precedence; ANTHROPIC_API_KEY is
# still read as a fallback so existing setups keep working.
#   Anthropic:          LLM_API_KEY=sk-ant-...
#   NVIDIA NIM et al.:  LLM_API_KEY=nvapi-...   (set provider/base_url in config)
LLM_API_KEY=
ANTHROPIC_API_KEY=sk-ant-...

# --- Venue credentials ---
# Alpaca: paper and live are different keys AND different hosts, so paper mode
# cannot reach the live account by accident.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# Coinbase Advanced Trade and Binance.US have NO paper endpoint between them —
# these are live-exchange keys, and the agent refuses to build either venue
# unless agent.mode = "live". Leave them unset until you mean it.
#
# Coinbase: the key name is organizations/{org}/apiKeys/{key}; the private key
# is the EC PEM issued with it. Escaped newlines (\n) are accepted, which is
# how it arrives when pasted out of the downloaded JSON.
COINBASE_API_KEY_NAME=
COINBASE_API_PRIVATE_KEY=

# Binance.US: HMAC key pair. The secret is shown once at creation.
BINANCE_US_API_KEY=
BINANCE_US_SECRET_KEY=

# Alerts
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Data sources
NOAA_API_TOKEN=xxx
ESPN_API_KEY=xxx

# Logging
RUST_LOG=info

# Database
DATABASE_URL=sqlite:polymarket-agent.db

# Dashboard access token — optional if dashboard_bind is loopback (default),
# required if you bind it to anything else (live mode refuses to start without it)
DASHBOARD_TOKEN=

# Optional: read config from somewhere other than config/default.toml.
# deploy/setup.sh sets this to /etc/polymarket-agent/config.toml so a
# deployment's tuned settings live outside the git checkout.
# CONFIG_PATH=

# --- Tracing (optional) ---
# Set either of these and span export turns itself on. Point at your own
# collector or a self-hosted Langfuse; nothing leaves the machine otherwise.
# LANGFUSE_HOST=http://localhost:3000
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Langfuse authenticates its OTLP ingest with these.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
