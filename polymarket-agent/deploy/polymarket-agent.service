[Unit]
Description=Polymarket Trading Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agent
WorkingDirectory=/opt/polymarket-agent
ExecStart=/opt/polymarket-agent/target/release/polymarket-agent
Restart=on-failure
RestartSec=30
Environment=RUST_LOG=info
# Secrets live outside the read-only install dir (see deploy/setup.sh)
EnvironmentFile=/etc/polymarket-agent/env

# Graceful shutdown: the agent handles SIGTERM but deliberately finishes the
# in-flight cycle first rather than abandoning an order mid-placement, so allow
# well beyond a normal cycle. A cycle retrying against a degraded network can
# legitimately run for minutes; SIGKILL after this is the last resort.
KillSignal=SIGTERM
TimeoutStopSec=300

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
StateDirectory=polymarket-agent
ReadWritePaths=/var/lib/polymarket-agent
ProtectHome=true

[Install]
WantedBy=multi-user.target
